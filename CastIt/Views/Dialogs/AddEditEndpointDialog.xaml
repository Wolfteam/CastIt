<views:MvxWindow
    x:Class="CastIt.Views.Dialogs.AddEditEndpointDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CastIt.Views.Dialogs"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:MvvmCross.Platforms.Wpf.Views;assembly=MvvmCross.Platforms.Wpf"
    xmlns:vm="clr-namespace:CastIt.ViewModels.Dialogs"
    Title="{Binding Title}"
    MinWidth="380"
    VerticalAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    d:DataContext="{d:DesignInstance Type=vm:AddEditEndpointDialogViewModel}"
    d:DesignHeight="200"
    d:DesignWidth="380"
    x:TypeArguments="vm:AddEditEndpointDialogViewModel"
    SizeToContent="WidthAndHeight"
    Style="{StaticResource WindowDialogStyle}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <materialDesign:ColorZone
            Padding="16"
            materialDesign:ElevationAssist.Elevation="Dp2"
            Background="{DynamicResource MaterialDesign.Brush.Primary.Dark}"
            DockPanel.Dock="Top">
            <DockPanel>
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="LanConnect" Style="{StaticResource ColorZoneIconStyle}" />
                    <TextBlock
                        Margin="5,0,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        d:Text="Add device"
                        Foreground="{DynamicResource FontColorOnDarkBackgroundBrush}"
                        Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                        Text="{Binding Title}" />
                </StackPanel>
            </DockPanel>
        </materialDesign:ColorZone>
        <ProgressBar
            Grid.Row="1"
            VerticalAlignment="Top"
            IsIndeterminate="true"
            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <Grid Grid.Row="1" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox
                x:Name="NameTextBox"
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Margin="10,5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                materialDesign:HintAssist.Hint="{Binding [Name]}"
                Foreground="{DynamicResource FontColorBrush}"
                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox
                x:Name="HostTextBox"
                Grid.Row="1"
                Grid.Column="0"
                Margin="10,5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                materialDesign:HintAssist.Hint="{Binding [Host]}"
                Foreground="{DynamicResource FontColorBrush}"
                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                Text="{Binding Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox
                x:Name="PortTextBox"
                Grid.Row="1"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Width="80"
                Margin="10,5"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                materialDesign:HintAssist.Hint="{Binding [Port]}"
                Foreground="{DynamicResource FontColorBrush}"
                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                Text="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Grid.Row="2"
                Grid.Column="1"
                Margin="0,5,0,0"
                Command="{Binding SaveCommand}"
                ToolTip="{Binding [Save]}">
                <Button.Style>
                    <Style BasedOn="{StaticResource MaterialDesignIconButton}" TargetType="{x:Type Button}">
                        <Setter Property="IsEnabled" Value="False" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsValid}" Value="True" />
                                    <Condition Binding="{Binding IsBusy}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsEnabled" Value="True" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <materialDesign:PackIcon
                    Width="24"
                    Height="24"
                    Kind="ContentSave" />
            </Button>
            <Button
                Grid.Row="2"
                Grid.Column="2"
                Margin="0,5,10,0"
                VerticalAlignment="Center"
                Command="{Binding CloseCommand}"
                ToolTip="{Binding [Close]}">
                <Button.Style>
                    <Style BasedOn="{StaticResource MaterialDesignIconButton}" TargetType="{x:Type Button}">
                        <Setter Property="IsEnabled" Value="True" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <materialDesign:PackIcon
                    Width="24"
                    Height="24"
                    Kind="CancelCircle" />
            </Button>
        </Grid>
    </Grid>
</views:MvxWindow>
